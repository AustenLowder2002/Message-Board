generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Messages {
    id Int @id @default(autoincrement())
    content String @db.Text
    likes Int @default(0)
    parentID Int? @map("parent_id")
    parent Messages? @relation("MessageToReplies", fields: [parentID], references: [id])
    replies Messages[] @relation("MessageToReplies")
}